# Copiar a .env. Los valores locales son sólo para el PostgreSQL de compose.yaml.
DATABASE_URL=postgresql+psycopg://club:club_local@localhost:5432/club
TEST_DATABASE_URL=postgresql+psycopg://club:club_local@localhost:5433/club_test
FIREBASE_PROJECT_ID=your-firebase-project-id
# Ruta absoluta a la cuenta de servicio (no incluir en Git).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# En Render se puede montar como secret file en /etc/secrets/firebase.json.
CORS_ORIGINS=http://localhost:3000
PORT=8000

# Alternativa a ADC/Secret File: JSON completo en una sola variable privada.
# FIREBASE_SERVICE_ACCOUNT_JSON=
FCM_ENABLED=false
SEED_ON_START=false
SEED_FILE=seed_data.json
